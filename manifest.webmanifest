{
  "name": "سجل غيابات الطلبة – نظام بولونيا",
  "short_name": "غيابات بولونيا",
  "description": "متابعة غيابات الطلبة وفق دليل اعتماد عملية بولونيا وإعداد المطالعة الأسبوعية لأستاذ المادة",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#1f5f8b",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./receive-file",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "file", "accept": ["application/json", "text/plain", "text/*", "application/octet-stream", ".json", ".txt"] }
      ]
    }
  }
}
